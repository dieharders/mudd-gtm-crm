{
  "name": "mudd",
  "version": "0.2.14",
  "description": "Mudd: Local-first prospect and enrichment CRM with spreadsheet import/export support.",
  "private": true,
  "license": "AGPL-3.0-only",
  "type": "module",
  "packageManager": "bun@1.4.2",
  "scripts": {
    "start": "bun run build:css && bun run main.ts",
    "dev": "bun run --hot scripts/dev.ts",
    "headless": "bun run build:css && bun run main.ts --headless",
    "build:css": "bunx @tailwindcss/cli -i ./src/client/styles.css -o ./src/client/generated.css --minify",
    "build": "bun run build:css && bun run build.ts",
    "icon": "bun run scripts/make-icon.ts",
    "screenshots": "bun run build:css && bun run scripts/screenshots/index.ts",
    "fixture": "bun run scripts/make-fixture.ts",
    "test": "bun test ./src/",
    "typecheck": "tsc --noEmit -p tsconfig.typecheck.json",
    "lint": "eslint .",
    "check": "bun run typecheck && bun run lint && bun test ./src/"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.283",
    "@hiseb/confetti": "2.2.0",
    "@tanstack/react-virtual": "^3.14.13",
    "exceljs": "^4.4.0",
    "jszip": "^3.10.2",
    "lucide-react": "^1.48.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-hot-toast": "^2.6.1",
    "react-router-dom": "^7",
    "tailwind-merge": "^3.7.0",
    "webview-bun": "^2.4.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/cli": "^4.3.3",
    "@types/bun": "^1.4.2",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "@typescript/native": "npm:typescript@^7.0.2",
    "eslint": "^10.11.0",
    "eslint-plugin-better-tailwindcss": "^4.7.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "happy-dom": "^20.14.5",
    "tailwindcss": "^4.3.3",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "typescript-eslint": "^8.71.0"
  }
}
